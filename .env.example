SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
HCP_API_KEY=
HCP_WEBHOOK_SECRET=
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=
# Optional overrides — default to the current live resi pipeline / stage IDs
GHL_RESI_PIPELINE_ID=
GHL_JOB_COMPLETED_STAGE_ID=
# Hub: forward completed events to the existing Zapier flow (keeps the sheet working)
ZAPIER_FORWARD_URL=
ZAPIER_FORWARD_EVENTS=job.completed
# Hub safety: dry-run is the default (logs intended actions, sends nothing).
# Set HUB_DRY_RUN=false ONLY when ready to send for real.
HUB_DRY_RUN=
HCP_REQUIRE_TOKEN=
# Secret for the daily reconcile cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
